type Query {
    assigneds(request: AssignRequest): [UserJobAssigned]
    userById(id: ID!): User
    jobById(id: ID!): Job
}
type Mutation {
    addJob(request: JobRequest): Job
    addUser(request: UserRequest): User
}

type UserJobAssigned {
    users: [User]
    job: Job
}

type User {
    id: ID
    firstName: String
    lastName: String
    email:String
    avatar: String
    jobId: Int
    job:Job

}

type Job {
    name:String
    salary:Float
    hours:Int
    id:ID
    resources:Int
}

input AssignRequest {
    requestNumber: Int
    clientName: String
}

input JobRequest {
    name: String
    salary: Float
    hours: Int
    resources: Int
}

input UserRequest {
    email: String
    firstName: String
    lastName: String
    avatar: String
    jobId: Int
}
